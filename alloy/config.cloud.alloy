// Listen for syslog messages on TCP port 1514 (octet-counted)
loki.source.syslog "meraki" {
  listener {
    address  = "0.0.0.0:1514"
    protocol = "tcp"
  }
  relabel_rules = loki.relabel.syslog_fields.rules
  forward_to = [loki.write.default.receiver, otelcol.receiver.loki.s3.receiver]
}

// Optional direct UDP syslog intake on port 1514 (no relay required)
loki.source.syslog "meraki_udp" {
  listener {
    address  = "0.0.0.0:1514"
    protocol = "udp"
  }
  relabel_rules = loki.relabel.syslog_fields.rules
  forward_to = [loki.write.default.receiver, otelcol.receiver.loki.s3.receiver]
}

loki.relabel "syslog_fields" {
	rule {
		source_labels = ["__syslog_message_severity"]
		target_label  = "level"
	}
	rule {
		replacement  = "meraki-syslog"
		target_label = "job"
	}
	rule {
		source_labels = ["__syslog_message_hostname"]
		regex         = "^([^_]+)_.*$"
		replacement   = "$1"
		target_label  = "instance"
	}
	rule {
		source_labels = ["__syslog_message_app_name"]
		target_label  = "syslog_app_name"
	}
	forward_to = []
}

// Optional Fleet Management enrollment for remote configuration.
// Leave FLEET_MANAGEMENT_* empty if Fleet enrollment is not needed.
remotecfg {
	url = sys.env("FLEET_MANAGEMENT_URL")

	basic_auth {
		username = sys.env("FLEET_MANAGEMENT_USERNAME")
		password = sys.env("FLEET_MANAGEMENT_PASSWORD")
	}

	// Keep a stable collector identity in Fleet for this dockerized setup.
	id             = "alloy-docker"
	attributes     = {"environment" = "docker", "service" = "alloy"}
	poll_frequency = "5m"
}

// Loki Push API receiver endpoint:
// POST http://localhost:9999/loki/api/v1/push
loki.source.api "loki_push_api" {
	http {
		listen_address = "0.0.0.0"
		listen_port    = 9999
	}

	use_incoming_timestamp = true
	labels = {
		job = "alloy-loki-api",
	}

	forward_to = [loki.write.default.receiver, otelcol.receiver.loki.s3.receiver]
}

// Send logs to Grafana Cloud Loki.
// Set LOKI_URL in your env file. For Cloud also set LOKI_USERNAME and GCLOUD_RW_API_KEY.
loki.write "default" {
  endpoint {
    url = sys.env("LOKI_URL")

    basic_auth {
      username = sys.env("LOKI_USERNAME")
      password = sys.env("GCLOUD_RW_API_KEY")
    }
  }
}

// Receive OTLP traces and forward them to Grafana Cloud Tempo.
otelcol.receiver.otlp "tempo_ingest" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		traces = [otelcol.exporter.otlphttp.to_tempo.input]
	}
}

otelcol.exporter.otlphttp "to_tempo" {
	client {
		endpoint = sys.env("TEMPO_URL")

		auth = otelcol.auth.basic.tempo_auth.handler
	}
}

otelcol.auth.basic "tempo_auth" {
	username = sys.env("TEMPO_USERNAME")
	password = sys.env("GCLOUD_RW_API_KEY")
}

// Also write every log line to S3 (in addition to Grafana Cloud Loki).
// Objects are gzip-compressed OTLP JSON under <S3_PREFIX>/year=YYYY/month=MM/day=DD/hour=HH/minute=MM/ (UTC),
// named logs_<uuid>.json.gz. Stream labels are kept as attributes on each log record.
// Set S3_BUCKET, S3_REGION and S3_PREFIX in your env file. AWS credentials are picked up from the
// standard AWS_* environment variables (or an assumed role) by the AWS SDK.
otelcol.receiver.loki "s3" {
	output {
		logs = [otelcol.processor.batch.s3.input]
	}
}

// Group log lines into fewer, larger S3 objects instead of one object per line.
otelcol.processor.batch "s3" {
	timeout = "30s"

	output {
		logs = [otelcol.exporter.awss3.logs.input]
	}
}

otelcol.exporter.awss3 "logs" {
	s3_uploader {
		region                = sys.env("S3_REGION")
		s3_bucket             = sys.env("S3_BUCKET")
		s3_prefix             = sys.env("S3_PREFIX")
		s3_partition_timezone = "UTC"
		compression           = "gzip"
	}

	marshaler {
		type = "otlp_json"
	}
}
