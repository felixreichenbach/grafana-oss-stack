// Bootstrap config for Grafana Cloud mode.
// The collector only enrolls in Fleet Management; log and trace ingest (and the S3 export) are delivered
// as Fleet pipelines from fleet/pipelines/ (deploy with fleet/deploy.sh).
// FLEET_MANAGEMENT_* must be set. Credentials and endpoints used by the pipelines come from this
// container's environment (see .env.cloud.example).
remotecfg {
	url = sys.env("FLEET_MANAGEMENT_URL")

	basic_auth {
		username = sys.env("FLEET_MANAGEMENT_USERNAME")
		password = sys.env("FLEET_MANAGEMENT_PASSWORD")
	}

	// Keep a stable collector identity in Fleet for this dockerized setup.
	// The pipelines in fleet/pipelines/ select collectors with these attributes (matchers).
	id = "alloy-docker"
	attributes = {
		"environment" = "docker",
		"service"     = "alloy",
		"log_ingest"     = "true",
		"metrics_ingest" = "true",
		"otlp_ingest"    = "true",
	}
	poll_frequency = "1m"
}
