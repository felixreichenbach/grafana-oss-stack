// Loki Push API receiver endpoint:
// POST http://localhost:9999/loki/api/v1/push
loki.source.api "loki_push_api" {
	http {
		listen_address = "0.0.0.0"
		listen_port    = 9999
	}

	use_incoming_timestamp = true
	labels = {
		job = "alloy-loki-api",
	}

	forward_to = [loki.write.default.receiver]
}

// Local mode: write directly to local Loki without auth.
loki.write "default" {
  endpoint {
		url = "http://loki:3100/loki/api/v1/push"
  }
}

// Receive OTLP traces (e.g., from Tempo self-telemetry) and forward them to Tempo.
otelcol.receiver.otlp "tempo_ingest" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		traces = [otelcol.exporter.otlphttp.to_tempo.input]
	}
}

otelcol.exporter.otlphttp "to_tempo" {
	client {
		endpoint = "http://tempo:4318"
	}
}
